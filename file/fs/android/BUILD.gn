import("//build/ohos.gni")

java_library("fs_uri_opener_android_java") {
  java_files = [
    "java/src/ohos/ace/plugin/fsuriopener/FsUriOpenerPlugin.java",
  ]
  classpath_deps = [
    "//foundation/arkui/ace_engine/adapter/android/build:ace_android_adapter_java",
  ]

  subsystem_name = "plugins"
  part_name = "file_fs"
}

ohos_combine_jars("fs_uri_opener_java") {
  deps = [ ":fs_uri_opener_android_java" ]

  subsystem_name = "plugins"
  part_name = "file_fs"
  jar_path = "${root_out_dir}/plugins/file/ace_fs_uri_opener_android.jar"
}

ohos_source_set("fs_uri_opener_android_jni") {
  sources = [ "uri_opener_android.cpp" ]

  include_dirs = [ "../src" ]
  defines = [ "ANDROID_PLATFORM" ]

  deps = [
    ":fs_uri_opener_java",
    "//plugins/interfaces/native:ace_plugin_util_android",
  ]

  subsystem_name = "plugins"
  part_name = "file_fs"
}
