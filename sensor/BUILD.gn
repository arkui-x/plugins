import("//plugins/sensor/sensor.gni")

template("plugin_sensor_static") {
  forward_variables_from(invoker, "*")

  ohos_source_set(target_name) {
    defines += invoker.defines
    cflags_cc += invoker.cflags_cc

    include_dirs = sensor_include
    sources = sensor_source

    deps = [
      "//base/hiviewdfx/hilog/interfaces/native/innerkits:libhilog_${platform}",
      "//plugins/interfaces/native:ace_plugin_util_${platform}",
      "//plugins/interfaces/native:plugin_log",
      "//plugins/libs/napi:napi_${target_os}",
      "//plugins/libs/uv:uv_${platform}",
    ]

    if (platform == "android") {
      sources += [ "$SENSOR_ROOT/frameworks/android/sensor_service_android.cpp" ]
      include_dirs += [ "//prebuilts/androidsdk" ]
      defines += [ "ANDROID_PLATFORM" ]
      libs = [ "android" ]
    } else if (platform == "ios") {
      sources += [ "$SENSOR_ROOT/frameworks/ios/sensor_service_ios.mm" ]
      include_dirs += [ "$SENSOR_ROOT/frameworks/ios" ]
      defines += [ "IOS_PLATFORM" ]
    }

    subsystem_name = "plugins"
    part_name = "sensor"
  }
}

foreach(item, ace_platforms) {
  plugin_sensor_static("sensor_static_" + item.name) {
    platform = item.name

    defines = []
    cflags_cc = []
    config = {
    }

    if (defined(item.config)) {
      config = item.config
    }

    if (defined(config.defines)) {
      defines = config.defines
    }

    if (defined(config.cflags_cc)) {
      cflags_cc = config.cflags_cc
    }
  }
}
