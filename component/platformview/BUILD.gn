import("//foundation/arkui/ace_engine/ace_config.gni")
import("//foundation/graphic/graphic_2d/graphic_config.gni")
import("//plugins/component/components.gni")

config("platformview_skia_config") {
  include_dirs = [ "$skia_root_new" ]
  if (graphic_2d_feature_upgrade_skia) {
    defines = [ "USE_M133_SKIA" ]
  }
}

build_arkui_x_component("platformview_source") {
  js_source = "platformview"
  sources = [
    "//foundation/arkui/ace_engine/frameworks/core/common/platform_res_register.cpp",
    "platform_view_impl.cpp",
    "platformview_layout_algorithm.cpp",
    "platformview_model_ng.cpp",
    "platformview_napi.cpp",
    "platformview_pattern.cpp",
    "resource/platform_view_delegate.cpp",
    "resource/platform_view_resource.cpp",
  ]
  configs = [
    "//foundation/graphic/graphic_2d/rosen/modules/render_service_client:render_service_client_config",
    "//foundation/graphic/graphic_2d/rosen/modules/render_service_base:export_config",
    "//foundation/graphic/graphic_2d/rosen/modules/2d_graphics:export_config",
    "//foundation/graphic/graphic_2d/rosen/modules/platform:ipc_core_config",
    "//foundation/graphic/graphic_2d/rosen/modules/platform:utils_config",
    "//foundation/graphic/graphic_2d/rosen/modules/platform:eventhandler_config",
    "//foundation/graphic/graphic_2d/rosen/modules/platform:image_native_config",
    "//commonlibrary/c_utils/base:utils_config",
    "//foundation/graphic/graphic_2d/frameworks/text:rosen_text_config",
    "//foundation/graphic/graphic_surface/surface:surface_headers_config",
    ":platformview_skia_config",
  ]
}
