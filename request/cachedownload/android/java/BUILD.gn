import("//build/ohos.gni")
import("//foundation/arkui/ace_engine/ace_config.gni")

java_library("cache_download_android_java") {
  java_files = [
    "src/ohos/ace/plugin/cachedownloadplugin/CacheDownloadPlugin.java",
    "src/ohos/ace/plugin/cachedownloadplugin/CacheDownloadHttpClient.java",
    "src/ohos/ace/plugin/cachedownloadplugin/CacheDownloadOptions.java",
    "src/ohos/ace/plugin/cachedownloadplugin/DownloadInfo.java",
    "src/ohos/ace/plugin/cachedownloadplugin/RetryOptions.java",
    "src/ohos/ace/plugin/cachedownloadplugin/TimeoutOptions.java",
  ]
  subsystem_name = "plugins"
  part_name = "request_cache_download"
}

ohos_source_set("cache_download_android_jni") {
  sources = [ "jni/cache_download_jni.cpp" ]

  defines = [ "CACHE_DOWNLOAD_ENABLE_JNI", "ANDROID_PLATFORM" ]

  include_dirs = [
    "../../include",
    "../../android",
    "//plugins/interfaces",
  ]

  deps = [
    "//plugins/request/cachedownload:cache_download_java",
    "//plugins/interfaces/native:ace_plugin_util_android",
  ]

  subsystem_name = "plugins"
  part_name = "request_cache_download"
}
