import("//build/ohos.gni")
import("//foundation/arkui/ace_engine/ace_config.gni")

_CD_ROOT = "//plugins/request/cachedownload"

config("cache_download_client_config") {
  include_dirs = [
    "${_CD_ROOT}/framework/innerkits/include",
    "${_CD_ROOT}/include",
    "//plugins/interfaces",
  ]

  if (current_os == "android") {
    include_dirs += [
      "${_CD_ROOT}/android",
      "${_CD_ROOT}/android/java/jni",
    ]
  } else if (current_os == "ios") {
    include_dirs += [ "${_CD_ROOT}/ios" ]
  }
}

ohos_source_set("cache_download_client") {
  public_configs = [ ":cache_download_client_config" ]

  sources = [
    "src/cache_download_client.cpp",
    "${_CD_ROOT}/src/cache_download_service.cpp",
    "${_CD_ROOT}/src/cache_task.cpp",
    "${_CD_ROOT}/src/cache_manager.cpp",
    "${_CD_ROOT}/src/cache_ram.cpp",
    "${_CD_ROOT}/src/cache_file.cpp",
    "${_CD_ROOT}/src/cache_space.cpp",
  ]

  if (current_os == "android") {
    sources += [ "${_CD_ROOT}/android/cache_http_client_impl.cpp" ]
    defines = [ "CACHE_DOWNLOAD_ENABLE_JNI", "ANDROID_PLATFORM" ]
    deps = [
      "${_CD_ROOT}/android/java:cache_download_android_jni",
      "//plugins/interfaces/native:ace_plugin_util_inner_${current_os}",
    ]
  } else if (current_os == "ios") {
    sources += [
      "${_CD_ROOT}/ios/cache_http_client_ios.mm",
      "${_CD_ROOT}/ios/cache_download_ios_utils.mm",
    ]
    defines = [ "IOS_PLATFORM" ]
    cflags_objc = [ "-fobjc-arc" ]
    cflags_objcc = [ "-fobjc-arc" ]
    deps = [
      "//plugins/interfaces/native:ace_plugin_util_inner_${current_os}",
      # cache_log.h includes "hilog/log.h" under IOS_PLATFORM. libhilog_ios is
      # a static library whose public_configs propagates the hilog include
      # dir; without this dep the iOS engine gate fails with
      # "'hilog/log.h' file not found" when ace_osal_ios pulls this
      # source_set in (Android does not hit this: it includes <android/log.h>
      # from the NDK sysroot instead).
      "//base/hiviewdfx/hilog/interfaces/native/innerkits:libhilog_${target_os}",
    ]
    libs = [ "sqlite3" ]
    frameworks = [ "Foundation.framework" ]
  }

  subsystem_name = "plugins"
  part_name = "request_cache_download"
}
